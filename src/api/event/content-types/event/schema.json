{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "CONCERT",
        "CONFERENCE",
        "ACTIVITY",
        "STAND",
        "OTHER"
      ]
    },
    "status_event": {
      "type": "enumeration",
      "required": false,
      "default": "DRAFT",
      "enum": [
        "DRAFT",
        "PUBLISHED",
        "CANCELLED",
        "ARCHIVED"
      ]
    },
    "startsAt": {
      "type": "datetime",
      "required": true
    },
    "day": {
      "type": "enumeration",
      "enum": ["VEN", "SAM", "DIM"],
      "required": true
    },
    "endsAt": {
      "type": "datetime"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "origin": {
      "type": "string",
      "default": "FR"
    },
    "capacity": {
      "type": "integer"
    },
    "isFeatured": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::event-category.event-category",
      "inversedBy": "events"
    },
    "genre": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::music-genre.music-genre",
      "inversedBy": "events"
    },
    "location": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::location.location",
      "inversedBy": "events"
    },
    "eventArtists": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::event-artist.event-artist",
      "mappedBy": "event"
    },
    "eventSponsors": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::event-sponsor.event-sponsor",
      "mappedBy": "event"
    },
    "mapPoints": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::map-point.map-point",
      "mappedBy": "event"
    },
    "standEvents": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::stand-event.stand-event",
      "mappedBy": "event"
    },
    "featuredOnHomePages": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::home-page.home-page",
      "mappedBy": "featuredEvents"
    }
  }
}

{
  "kind": "collectionType",
  "collectionName": "stands",
  "info": {
    "singularName": "stand",
    "pluralName": "stands",
    "displayName": "Stand"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "unique": true
    },
    "description": {
      "type": "text"
    },
    "type": {
      "type": "enumeration",
      "enum": ["FOOD", "DRINK", "MERCH", "INFO", "SPONSOR", "OTHER"],
      "default": "OTHER",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["ACTIVE", "INACTIVE"],
      "default": "ACTIVE",
      "required": true
    },
    "imageUrl": {
      "type": "string"
    },
    "location": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::location.location",
      "inversedBy": "stands"
    },
    "sponsor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::sponsor.sponsor",
      "inversedBy": "stands"
    },
    "standEvents": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::stand-event.stand-event",
      "mappedBy": "stand"
    }
  }
}

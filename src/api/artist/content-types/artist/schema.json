{
  "kind": "collectionType",
  "collectionName": "artists",
  "info": {
    "singularName": "artist",
    "pluralName": "artists",
    "displayName": "Artist"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "unique": true
    },
    "type": {
      "type": "enumeration",
      "enum": ["ARTIST", "SPEAKER", "HOST"],
      "default": "ARTIST",
      "required": true
    },
    "bio": {
      "type": "text"
    },
    "imageUrl": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "eventArtists": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::event-artist.event-artist",
      "mappedBy": "artist"
    }
  }
}

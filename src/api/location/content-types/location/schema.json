{
  "kind": "collectionType",
  "collectionName": "locations",
  "info": {
    "singularName": "location",
    "pluralName": "locations",
    "displayName": "Location"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "unique": true
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "STAGE",
        "STAND",
        "ENTRANCE",
        "RESTROOM",
        "FOOD",
        "INFO",
        "FIRST_AID",
        "OTHER"
      ],
      "required": true
    },
    "description": {
      "type": "text"
    },
    "address": {
      "type": "string"
    },
    "latitude": {
      "type": "float"
    },
    "longitude": {
      "type": "float"
    },
    "events": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::event.event",
      "mappedBy": "location"
    },
    "stands": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::stand.stand",
      "mappedBy": "location"
    },
    "mapPoints": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::map-point.map-point",
      "mappedBy": "location"
    }
  }
}
